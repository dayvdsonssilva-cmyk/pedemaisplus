{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/generate-image.js": { "maxDuration": 60 },
    "api/transcribe.js":     { "maxDuration": 30 },
    "api/claude.js":         { "maxDuration": 30 },
    "api/analyze.js":        { "maxDuration": 30 },
    "api/guru.js":           { "maxDuration": 30 },
    "api/create-pix.js":     { "maxDuration": 15 },
    "api/check-payment.js":  { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/", "dest": "/aventura.html" },
    { "src": "/(.*)", "dest": "/aventura.html" }
  ]
}
